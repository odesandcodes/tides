<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TideTrack</title>
    <style is:global>
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            background: #f0f2f5; margin: 0; padding: 20px; 
            display: flex; flex-direction: column; align-items: center; 
        }
        button { cursor: pointer; }
        .header { text-align: center; margin-bottom: 20px; width: 100%; max-width: 450px; }
        .title { font-size: 26px; margin: 0 0 5px 0; font-weight: 900; letter-spacing: -0.5px; }
        .highlight { color: #007AFF; }
        .clock-badge {
            background: white; padding: 4px 12px; border-radius: 20px; 
            font-weight: 700; color: #555; display: inline-block; 
            border: 1px solid #ddd; font-size: 13px; margin-top: 5px;
        }
        .action-btn {
            background: white; border: 1px solid #ddd; border-radius: 12px;
            padding: 12px 24px; font-weight: 600; color: #333;
            display: flex; align-items: center; gap: 8px; font-size: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 10px;
        }
        .action-btn:active { background: #f0f0f0; transform: scale(0.98); }
        .disclaimer-box {
            font-size: 10px; color: #999; margin-top: 25px; 
            line-height: 1.6; max-width: 320px; text-align: center;
        }
        .chart-wrap { position: relative; height: 110px; margin: 8px 0 4px; }

    /* 5-day tide table — mini cards grid */
        .five-day-tides { margin-top: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .day-col {
            background: #f8f9fb; border-radius: 10px; padding: 8px 10px;
        }
        .day-col.today { background: #f0f9ff; }
        .day-label { font-size: 10px; font-weight: 800; color: #007AFF; letter-spacing: 0.3px; text-transform: uppercase; margin-bottom: 5px; }
        .tide-event { display: flex; align-items: center; gap: 4px; margin-bottom: 3px; }
        .tide-event:last-child { margin-bottom: 0; }
        .tide-type { font-weight: 800; font-size: 9px; width: 26px; flex-shrink: 0; }
        .tide-type.high { color: #007AFF; }
        .tide-type.low  { color: #ef4444; }
        .tide-time { font-size: 11px; color: #333; font-weight: 700; }
        .tide-val  { font-size: 10px; color: #aaa; }

    </style>
</head>
<body>

    <div class="header">
        <h1 class="title">Tide<span class="highlight">Track</span></h1>
        <div id="clock" class="clock-badge">--:--</div>
    </div>

    <button class="action-btn" onclick="window.useMyLocation()">
        📍 Find Nearest Station
    </button>
    
    <div id="statusMsg" style="text-align: center; font-size: 12px; color: #666; margin-bottom: 20px; height: 18px;"></div>

    <div id="app" style="width: 100%; max-width: 450px;">
        <div style="text-align: center; color: #888; padding: 20px;">Loading Data...</div>
