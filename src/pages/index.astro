---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TideTrack Debug</title>
    <style>
        body { font-family: sans-serif; background: #f0f2f5; margin: 0; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        button { cursor: pointer; }
        .header { text-align: center; margin-bottom: 20px; }
        .action-btn { background: white; border: 1px solid #ddd; padding: 12px 20px; border-radius: 12px; margin: 5px; font-weight: bold; }
        .error-box { background: #fee2e2; border: 1px solid #ef4444; color: #b91c1c; padding: 10px; border-radius: 8px; margin-bottom: 20px; display: none; width: 100%; max-width: 400px; font-size: 12px; font-family: monospace; word-break: break-all; }
    </style>
</head>
<body>

    <div class="header">
        <h1>TideTrack 🛠</h1>
    </div>

    <div id="globalError" class="error-box"></div>

    <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <button class="action-btn" onclick="window.useMyLocation()">📍 Use GPS</button>
        <button class="action-btn" onclick="window.simulateSF()">🌉 Test SF</button>
    </div>

    <div id="statusMsg" style="text-align: center; color: #666; margin-bottom: 20px; height: 20px;"></div>

    <div id="app" style="width: 100%; max-width: 450px;">
        <div style="text-align: center; color: #888;">Initializing...</div>
    </div>

    <script is:inline>
        // --- 1. GLOBAL ERROR TRAP ---
        window.onerror = function(msg, url, line) {
            const box = document.getElementById('globalError');
            box.style.display = 'block';
            box.innerText = `CRASH: ${msg} (Line ${line})`;
            return false;
        };

        // --- 2. DATABASE ---
        const STATION_DB = [
            { id: "8661070", name: "Myrtle Beach", lat: 33.6552, lon: -78.9047, zone: "America/New_York" },
            { id: "8517201", name: "Jamaica Bay", lat: 40.5956, lon: -73.8342, zone: "America/New_York" },
            { id: "9410580", name: "Newport Beach", lat: 33.6033, lon: -117.8831, zone: "America/Los_Angeles" },
            { id: "8443970", name: "Boston", lat: 42.3539, lon: -71.0503, zone: "America/New_York" },
            { id: "9414290", name: "San Francisco", lat: 37.806, lon: -122.465, zone: "America/Los_Angeles" },
            { id: "8729108", name: "Panama City", lat: 30.151, lon: -85.666, zone: "America/Chicago" },
            { id: "9447130", name: "Seattle", lat: 47.601, lon: -122.339, zone: "America/Los_Angeles" }
        ];
        const DEFAULT_IDS = ["8661070", "8517201", "9410580"];

        // --- 3. EXPOSE FUNCTIONS TO WINDOW (Fixes dead buttons) ---
        window.setStatus = function(msg) {
            document.getElementById('statusMsg').innerText = msg;
        };

        window.simulateSF = function() {
            window.setStatus("🛠 Simulating San Francisco...");
            window.handleLocation(37.806, -122.465);
        };

        window.useMyLocation = function() {
            if (!navigator.geolocation) { 
                window.setStatus("GPS Not Supported"); 
                return; 
            }
            window.setStatus("📡 Requesting GPS...");
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    window.setStatus("✅ GPS Found!");
                    window.handleLocation(pos.coords.latitude, pos.coords.longitude);
                },
                (err) => { 
                    window.setStatus(`🚫 Error: ${err.message}`); 
                }
            );
        };

        window.handleLocation = function(lat, lon) {
            let closest = null;
            let minDist = Infinity;
            STATION_DB.forEach(st => {
                const R = 6371; 
                const dLat = (st.lat - lat) * Math.PI / 180;
                const dLon = (st.lon - lon) * Math.PI / 180;
                const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                          Math.cos(lat * Math.PI / 180) * Math.cos(st.lat * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                const dist = R * c;
                if (dist < minDist) { minDist = dist; closest = st; }
            });

            if (closest) {
                window.setStatus(`Nearest: ${closest.name}`);
                renderApp(closest);
            } else {
                window.setStatus("No station found.");
            }
        };

        // --- 4. FETCH LOGIC ---
        async function fetchStationData(station) {
            try {
                const cb = Date.now() + Math.random();
                // Simpler Date Logic to avoid crashes
                const d = new Date(); d.setDate(d.getDate() - 1);
                const beginDate = `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
                
                const urlBase = `https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?station=${station.id}&begin_date=${beginDate}&range=72&product=predictions&datum=MLLW&time_zone=lst_ldt&units=english&format=json&application=TideTrack&cb=${cb}`;
                
                const [schedRes, curRes] = await Promise.all([fetch(urlBase + "&interval=hilo"), fetch(urlBase)]);
                const schedData = await schedRes.json();
                const curData = await curRes.json();

                let currentLevel = "---";
                let trend = "---";
                
                // Helper to parse NOAA time string "YYYY-MM-DD HH:MM" to Int
                const noaaToInt = (t) => parseInt(t.replace(/[- :]/g, ''));
                
                // Get Station Wall Clock Time
                const now = new Date();
                const timeString = now.toLocaleString("en-US", {timeZone: station.zone, hour12: false}); 
                // Simple parsing of locale string to Int (Robust method)
                const tempDate = new Date(timeString);
                const stationTimeInt = parseInt(`${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}${String(tempDate.getHours()).padStart(2,'0')}${String(tempDate.getMinutes()).padStart(2,'0')}`);

                if (curData.predictions) {
                    const closest = curData.predictions.reduce((prev, curr) => {
                        return (Math.abs(stationTimeInt - noaaToInt(curr.t)) < Math.abs(stationTimeInt - noaaToInt(prev.t))) ? curr : prev;
                    });
                    currentLevel = parseFloat(closest.v).toFixed(1);
                    
                    // Trend
                    const idx = curData.predictions.indexOf(closest);
                    if (idx < curData.predictions.length - 1) {
                         const nextVal = parseFloat(curData.predictions[idx+1].v);
                         trend = nextVal > parseFloat(currentLevel) ? "RISING" : "FALLING";
                    }
                }

                let timeline = [];
                if (schedData.predictions) {
                    timeline = schedData.predictions
                        .filter(p => noaaToInt(p.t) > stationTimeInt)
                        .slice(0, 4)
                        .map(p => ({ time: p.t, val: p.v, isHigh: p.type === 'H' }));
                }

                return { ...station, current: currentLevel, trend, timeline };
            } catch (err) {
                console.error(err);
                return { ...station, error: true, msg: err.message };
            }
        }

        async function renderApp(foundStation = null) {
            const container = document.getElementById('app');
            if (foundStation || container.innerText.includes('Initializing')) {
                container.innerHTML = '<div style="padding:20px;">Loading Tides...</div>';
            }

            let list = [];
            if (foundStation) list.push({ ...foundStation, isFound: true });
            DEFAULT_IDS.forEach(id => {
                const s = STATION_DB.find(x => x.id === id);
                if (s) list.push(s);
            });

            const results = await Promise.all(list.map(fetchStationData));
            
            let html = '';
            results.forEach(st => {
                if (st.error) {
                    html += `<div style="color:red; background:#fee; padding:15px; margin-bottom:10px; border-radius:10px;">⚠️ Error: ${st.name}</div>`;
                    return;
                }
                
                let rows = st.timeline.map(e => {
                    const tParts = e.time.split(' ')[1].split(':');
                    let h = parseInt(tParts[0]);
                    const suffix = h >= 12 ? 'PM' : 'AM';
                    h = h % 12 || 12;
                    return `
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #eee;">
                        <span style="font-weight:bold; color:${e.isHigh?'#007AFF':'#555'}">${e.isHigh?'HIGH':'LOW'}</span>
                        <span>${parseFloat(e.val).toFixed(1)} ft <span style="color:#888; font-size:0.8em;">${h}:${tParts[1]} ${suffix}</span></span>
                    </div>`;
                }).join('');

                const style = st.isFound ? "border: 2px solid #007AFF; background:#f0f9ff;" : "background:white;";
                
                html += `
                <div style="${style} padding:20px; border-radius:16px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                    <div style="font-size:18px; font-weight:800; margin-bottom:5px;">${st.name}</div>
                    <div style="font-size:32px; font-weight:900; color:#007AFF;">
                        ${st.current}<span style="font-size:16px; color:#999;">ft</span> 
                        <span style="font-size:14px; color:${st.trend==='RISING'?'green':'red'}; background:#eee; padding:2px 6px; border-radius:4px;">${st.trend}</span>
                    </div>
                    <div style="margin-top:15px;">${rows}</div>
                </div>`;
            });
            container.innerHTML = html;
        }

        // --- 5. STARTUP ---
        alert("System Ready: Click OK to start."); // PROOF OF LIFE
        renderApp();
    </script>
</body>
</html>